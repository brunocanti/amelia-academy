{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.amelia.academy/v1/memory-event.schema.json",
  "title": "MemoryEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "project_id", "subject_id", "event_type", "occurred_at", "ingested_at", "privacy_scope", "payload_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "subject_id": {"$ref": "#/$defs/id"},
    "event_type": {"enum": ["message", "action", "result", "correction", "remember_request", "forget_request", "claim_mutation"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "ingested_at": {"type": "string", "format": "date-time"},
    "privacy_scope": {"enum": ["session", "subject", "project"]},
    "payload_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_event_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|[0-9A-HJKMNP-TV-Z]{26})$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
