{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://schemas.amelia.academy/v2/training-manifest.schema.json",
  "title": "TrainingManifest",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "profile": {
      "enum": [
        "direct",
        "reasoned",
        "both"
      ]
    },
    "canonical_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "confidence_rule": {
      "const": "curation-1"
    },
    "confidence_levels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "medium",
          "high"
        ]
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direct": {
          "type": "integer",
          "minimum": 0
        },
        "reasoned": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "direct",
        "reasoned"
      ]
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "lines": {
            "type": "integer",
            "minimum": 0
          },
          "by_kind": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "required": [
          "sha256",
          "lines"
        ]
      }
    },
    "reasoned_excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sample_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "sample_id",
          "reason"
        ]
      }
    },
    "reasoned_format": {
      "const": "editorial-rationale-v1"
    },
    "reasoned_renderer": {
      "type": "null"
    },
    "identity": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "identity_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "split_policy": {
      "const": "balanced-by-kind-1"
    },
    "split_warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "missing": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "train",
                "validation",
                "test"
              ]
            }
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "count",
          "missing",
          "message"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "profile",
    "canonical_sha256",
    "confidence_rule",
    "confidence_levels",
    "statistics",
    "files",
    "reasoned_excluded",
    "reasoned_format",
    "reasoned_renderer",
    "identity",
    "identity_sha256",
    "split_policy",
    "split_warnings",
    "entries"
  ]
}
