{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.amelia.academy/v1/dataset-manifest.schema.json",
  "title": "DatasetManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "project_id", "created_at", "entries", "statistics", "canonical_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_id", "sample_revision", "sample_sha256", "split", "scenario_group", "source_group"],
        "properties": {
          "sample_id": {"$ref": "#/$defs/id"},
          "sample_revision": {"type": "integer", "minimum": 1},
          "sample_sha256": {"$ref": "#/$defs/sha256"},
          "split": {"enum": ["train", "validation", "test"]},
          "scenario_group": {"type": "string", "minLength": 1},
          "source_group": {"type": "string", "minLength": 1},
          "training_consent_id": {"$ref": "#/$defs/id"}
        }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_samples", "by_split"],
      "properties": {
        "total_samples": {"type": "integer", "minimum": 1},
        "by_split": {
          "type": "object",
          "additionalProperties": false,
          "required": ["train", "validation", "test"],
          "properties": {
            "train": {"type": "integer", "minimum": 0},
            "validation": {"type": "integer", "minimum": 0},
            "test": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|[0-9A-HJKMNP-TV-Z]{26})$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
