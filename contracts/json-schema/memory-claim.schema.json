{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.amelia.academy/v1/memory-claim.schema.json",
  "title": "MemoryClaim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_id", "project_id", "subject_id", "claim_type", "status", "value", "confidence", "explicitness", "sensitivity", "privacy_scope", "valid_from", "recorded_at", "evidence_event_ids"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "claim_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "subject_id": {"$ref": "#/$defs/id"},
    "claim_type": {"enum": ["episode", "semantic", "preference", "goal", "commitment", "identity", "source"]},
    "status": {"enum": ["candidate", "active", "ignored", "contested", "superseded", "expired", "tombstoned"]},
    "value": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "explicitness": {"enum": ["explicit", "inferred"]},
    "sensitivity": {"enum": ["normal", "sensitive", "highly_sensitive"]},
    "privacy_scope": {"enum": ["session", "subject", "project"]},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_to": {"type": ["string", "null"], "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "supersedes_claim_id": {"$ref": "#/$defs/id"},
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "prompt_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "prompt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|[0-9A-HJKMNP-TV-Z]{26})$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
