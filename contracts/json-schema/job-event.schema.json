{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.amelia.academy/v1/job-event.schema.json",
  "title": "JobEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "job_id", "project_id", "attempt", "seq", "type", "occurred_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"$ref": "#/$defs/id"},
    "job_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "attempt": {"type": "integer", "minimum": 1},
    "seq": {"type": "integer", "minimum": 0},
    "type": {"enum": ["ready", "accepted", "progress", "log", "checkpoint", "artifact", "result", "error", "cancelled"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "phase": {"type": "string", "minLength": 1},
    "current": {"type": "integer", "minimum": 0},
    "total": {"type": "integer", "minimum": 0},
    "message": {"type": "string", "maxLength": 4096},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_path": {"type": "string", "minLength": 1},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"}
      }
    },
    "metrics": {"type": "object", "additionalProperties": {"type": "number"}}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "progress"}}}, "then": {"required": ["phase", "current"]}},
    {"if": {"properties": {"type": {"const": "error"}}}, "then": {"required": ["error"]}},
    {"if": {"properties": {"type": {"enum": ["artifact", "checkpoint"]}}}, "then": {"required": ["artifact_sha256"]}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|[0-9A-HJKMNP-TV-Z]{26})$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
